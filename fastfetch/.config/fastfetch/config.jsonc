{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "padding": {
            "top": 2,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": " ─ "
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "host": "blue"
            }
        },
        {
            "type": "custom",
            "format": "──────────────────────────────",
            "color": "gray"
        },
        {
            "type": "os",
            "key": "\u001b[31m󰣇 distro"
        },
        {
            "type": "kernel",
            "key": "\u001b[35m kernel"
        },
        {
            "type": "uptime",
            "key": "\u001b[33m󱎫 uptime"
        },
        {
            "type": "wm",
            "key": "\u001b[34m desktop"
        },
        {
            "type": "shell",
            "key": "\u001b[36m shell"
        },
        {
            "type": "terminal",
            "key": "\u001b[32m terminal"
        }
    ]
}
